{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "outDir": "./out"
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "config/**/*.json"]
}
